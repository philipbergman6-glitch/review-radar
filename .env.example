# ---- Kafka ----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_REVIEWS=reviews.raw

# ---- MinIO (S3-compatible object store) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lakehouse

# ---- Elasticsearch ----
ES_HOST=http://localhost:9200

# ---- Postgres (product metadata, SQL enrichment source) ----
PG_HOST=localhost
PG_PORT=5432
PG_DB=catalog
PG_USER=bigdata
PG_PASSWORD=bigdata

# ---- AI ----
# Local embedding model (runs on-device, no data leaves the machine)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM for enrichment / RAG. Public dataset only -> hosted API is acceptable here.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
